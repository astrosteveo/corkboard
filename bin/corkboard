#!/usr/bin/env python3
"""Corkboard's command line. Finds its package from its own path, so a symlink to it works."""

import sys

if sys.version_info < (3, 11):
    sys.exit("error: corkboard needs Python 3.11 or newer")

from pathlib import Path  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from corkboard.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
